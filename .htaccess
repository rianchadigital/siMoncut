# ====================================================================
# SiMONCUT - Hostinger Apache & LiteSpeed Configuration
# Sistem Monitoring Cuti Pegawai Puskesmas Kepulauan Seribu Selatan
# Tagline: “Pantau Cuti, Mudahkan Pengelolaan Kepegawaian”
# ====================================================================

# 1. Pastikan Apache memprioritaskan index.php agar auto-sync dan update bundle berjalan
DirectoryIndex index.php dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika parameter pemicu pembaruan dipanggil (?update=1, ?sync=1, dll)
  RewriteCond %{QUERY_STRING} (update|sync|rebuild|refresh) [NC]
  RewriteRule ^ index.php [L]

  # Jangan pernah menyajikan template root index.html mentah
  RewriteRule ^index\.html$ index.php [L]

  # Jika URL root diakses, arahkan ke index.php untuk validasi dan penyajian versi terbaru
  RewriteRule ^$ index.php [L]

  # Jika file yang diminta ada di dalam folder dist/ (seperti assets, favicon, manifest, sw)
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Izinkan akses langsung jika file memang ada di root (misal robots.txt, version.json, dll)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua rute SPA lainnya dialihkan ke index.php (yang menyajikan dist/index.html terbaru)
  RewriteRule ^.*$ index.php [L]
</IfModule>

# Pastikan MIME Types akurat untuk JavaScript ES Modules, CSS, Manifest, dan Font
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Header keamanan dan CORS untuk font & aset
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|svg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Cegah directory listing
Options -Indexes
